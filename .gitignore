# npm dependencies of the theme (the iconify sets declared in package.json).
# Ngwg installs them into the theme directory — see the README — and they are
# never committed.
node_modules/

# Bundled demo media (wallpapers, avatar, logo, favicons) is deliberately not
# part of this repository: the files come from third-party artwork and would
# pollute the source tree. The default theme.yaml still points at
# /assets/images/..., so copy your own files there (or under your site's
# source/assets/images/) — see the README.
assets/images/
