<%
const pg = page.pagination;
const pageUrl = (n) => (n <= 1 ? "/" : `/page/${n}/`);
let nums = [];
if (pg) {
  const total = pg.total, cur = pg.current;
  const from = Math.max(1, cur - 2), to = Math.min(total, cur + 2);
  for (let i = from; i <= to; i++) nums.push(i);
}
%>
<% if (pg && pg.total > 1) { %>
<nav class="pagination" aria-label="<%= t.pagination.page.replace('{0}', pg.current).replace('{1}', pg.total) %>">
  <% if (pg.prev) { %>
  <a class="pagination-btn newer" href="<%= pg.prev %>" rel="prev"><%- partial('icon', { name: 'chevron-left', size: 16 }) %><span><%= t.pagination.newer %></span></a>
  <% } else { %><span class="pagination-btn disabled"><%- partial('icon', { name: 'chevron-left', size: 16 }) %><span><%= t.pagination.newer %></span></span><% } %>

  <span class="pagination-pages">
    <% if (nums[0] > 1) { %><a class="pagination-num" href="/">1</a><% if (nums[0] > 2) { %><span class="pagination-gap">…</span><% } %><% } %>
    <% for (const n of nums) { %>
      <% if (n === pg.current) { %><span class="pagination-num current" aria-current="page"><%= n %></span>
      <% } else { %><a class="pagination-num" href="<%= pageUrl(n) %>"><%= n %></a><% } %>
    <% } %>
    <% if (nums[nums.length - 1] < pg.total) { %><% if (nums[nums.length - 1] < pg.total - 1) { %><span class="pagination-gap">…</span><% } %><a class="pagination-num" href="<%= pageUrl(pg.total) %>"><%= pg.total %></a><% } %>
  </span>

  <% if (pg.next) { %>
  <a class="pagination-btn older" href="<%= pg.next %>" rel="next"><span><%= t.pagination.older %></span><%- partial('icon', { name: 'chevron-right', size: 16 }) %></a>
  <% } else { %><span class="pagination-btn disabled"><span><%= t.pagination.older %></span><%- partial('icon', { name: 'chevron-right', size: 16 }) %></span><% } %>
</nav>
<% } %>
