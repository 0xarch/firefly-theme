<%
/**
 * Icon layer — the only place that knows which iconify icon backs a name.
 *
 * Call it as `partial('icon', { name: 'home', size: 20, extraClass: 'chev' })`.
 *
 * The drawings come straight from the iconify packs this theme depends on
 * (package.json — the same packs the original Firefly theme uses, so no icon
 * data is vendored here). Ngwg installs those packages into the theme
 * directory and the EJS deployer exposes a theme-scoped `require`, which is
 * what resolves the specifiers below.
 *
 * `name` is a public knob (theme.yaml writes icons for navbar/profile links),
 * so keep existing names when you change an icon.
 *
 * Resolution order for `name`:
 *   1. a full `collection:icon` reference is used as is (any installed pack);
 *   2. otherwise a short name is looked up in ICON_MANIFEST;
 *   3. otherwise it is searched in the theme's packs, in order (ICON_PACKS).
 * A name only the fallback can resolve is reported at verbose level (it works,
 * but pinning it in ICON_MANIFEST is the stable choice); a name nothing can
 * resolve warns, and renders as an empty placeholder instead of failing the
 * build. Messages print once per name per build, through the build log.
 */
const ICON_MANIFEST = {
  // ---- navigation & chrome ----
  home: "material-symbols:home",
  archive: "material-symbols:archive",
  user: "material-symbols:person",
  menu: "material-symbols:menu-rounded",
  close: "material-symbols:close-rounded",
  search: "material-symbols:search",
  link: "material-symbols:link",
  external: "material-symbols:open-in-new",
  "arrow-up": "material-symbols:keyboard-arrow-up-rounded",
  more: "material-symbols:more-horiz",
  "chevron-left": "material-symbols:chevron-left-rounded",
  "chevron-right": "material-symbols:chevron-right-rounded",
  "chevron-down": "material-symbols:keyboard-arrow-down-rounded",
  // ---- theme switch ----
  sun: "material-symbols:light-mode-outline-rounded",
  moon: "material-symbols:dark-mode-outline-rounded",
  monitor: "material-symbols:brightness-auto-outline-rounded",
  palette: "material-symbols:palette-outline",
  reset: "fa7-solid:arrow-rotate-left",
  // ---- post metadata & widgets ----
  calendar: "material-symbols:calendar-today-outline-rounded",
  "edit-calendar": "material-symbols:edit-calendar-outline-rounded",
  history: "material-symbols:history",
  list: "material-symbols:format-list-bulleted",
  clock: "material-symbols:schedule-outline-rounded",
  "file-text": "material-symbols:notes-rounded",
  chart: "material-symbols:bar-chart",
  type: "material-symbols:text-ad-outline-rounded",
  folder: "material-symbols:folder-open-rounded",
  tag: "material-symbols:tag-rounded",
  announcement: "material-symbols:campaign-outline",
  music: "material-symbols:music-note",
  "address-card": "fa7-regular:address-card",
  copyright: "fa7-regular:copyright",
  cc: "fa7-brands:creative-commons",
  github: "fa7-brands:github",
  rss: "fa7-solid:rss",
};

// resolve the reference into drawing data: iconify icon sets carry a pack-wide
// grid (material-symbols: 24, font awesome: 640) that an icon may override,
// and aliases that point at another icon in the same set
function lookupIcon(set, id, seen) {
  const icon = set.icons[id];
  if (icon) return icon;
  const alias = set.aliases && set.aliases[id];
  if (alias && alias.parent && seen.indexOf(id) < 0) return lookupIcon(set, alias.parent, seen.concat(id));
  return null;
}

// the packs a full reference is loaded from, and a bare (manifest-less) name is
// searched in — in this order, so the first pack that has the id wins
const ICON_PACKS = ["fa7-brands", "fa7-regular", "fa7-solid", "material-symbols"];

// A partial renders once per page, so the same message would print 70+ times in
// one build; keep one per level and text for the life of the process.
// `warn`/`debug` are the deployer's sinks, which route through the build log
// (they only exist when the template runs inside Ngwg — else use the console).
const reported = (globalThis.__ngwgIconReports = globalThis.__ngwgIconReports || new Set());
const sinks = {
  warn: typeof warn === "function" ? warn : function (msg) { console.warn(msg); },
  // verbose-only channel: notes that are worth knowing but need no action
  verbose: typeof debug === "function" ? debug : function (msg) { console.debug(msg); },
};
function report(level, msg) {
  const key = level + ": " + msg;
  if (reported.has(key)) return;
  reported.add(key);
  sinks[level]("theme icon: " + msg);
}

// load a pack's icon set; null when the package cannot be required
function loadPack(collection) {
  try {
    return require("@iconify-json/" + collection).icons;
  } catch (e) {
    return null;
  }
}

function toDrawing(set, icon) {
  return {
    w: icon.width || set.width || 24,
    h: icon.height || set.height || 24,
    x: icon.left || 0,
    y: icon.top || 0,
    body: icon.body,
  };
}

// "collection:icon" → drawing data (null + a warning when the pack is missing
// or the pack has no such icon)
function resolveRef(ref) {
  const sep = ref.indexOf(":");
  const collection = ref.slice(0, sep);
  const id = ref.slice(sep + 1);
  const set = loadPack(collection);
  if (!set) {
    report(
      "warn",
      `"${ref}" needs the pack @iconify-json/${collection}, which is not installed — ` +
        `add it to Ngwg-firefly-theme/package.json and run "bun install" in the theme directory ` +
        `(Ngwg installs theme dependencies automatically). Rendering an empty placeholder.`,
    );
    return null;
  }
  const icon = lookupIcon(set, id, []);
  if (!icon) {
    report(
      "warn",
      `"${ref}" is not an icon in @iconify-json/${collection} — check the name at https://iconify.design ` +
        `(the pack's aliases count too). Rendering an empty placeholder.`,
    );
    return null;
  }
  return toDrawing(set, icon);
}

// bare name with no manifest entry: note it (verbose — the fallback is allowed),
// then try the packs in order
function resolveBare(id) {
  report(
    "verbose",
    `"${id}" is not in ICON_MANIFEST — searched the theme's packs (${ICON_PACKS.join(" > ")}) as a fallback.`,
  );
  for (const collection of ICON_PACKS) {
    const set = loadPack(collection);
    if (!set) continue;
    const icon = lookupIcon(set, id, []);
    if (icon) {
      report(
        "verbose",
        `"${id}" resolved as ${collection}:${id} — add "${id}: ${collection}:${id}" to ICON_MANIFEST ` +
          `to pin the pack.`,
      );
      return toDrawing(set, icon);
    }
  }
  report(
    "warn",
    `no theme pack has an icon called "${id}" — check the name at https://iconify.design, ` +
      `or pass a full "collection:icon" reference. Rendering an empty placeholder.`,
  );
  return null;
}

const REF_RE = /^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$/;
const rawName = typeof name === "undefined" ? "" : String(name);
let drawing = null;
if (REF_RE.test(rawName)) {
  // a full reference is taken as given
  drawing = resolveRef(rawName);
} else if (Object.prototype.hasOwnProperty.call(ICON_MANIFEST, name)) {
  drawing = resolveRef(String(ICON_MANIFEST[name]));
} else {
  drawing = resolveBare(rawName);
}
const px = (typeof size !== "undefined" && size) ? size : 20;
const klass = (typeof extraClass !== "undefined" && extraClass) ? " " + extraClass : "";
%>
<% if (drawing) { %><svg class="icon<%= klass %>" width="<%= px %>" height="<%= px %>" viewBox="<%= drawing.x %> <%= drawing.y %> <%= drawing.w %> <%= drawing.h %>" fill="currentColor" aria-hidden="true" focusable="false"><%- drawing.body %></svg><% } %>
