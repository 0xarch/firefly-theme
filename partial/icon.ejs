<%
/**
 * Icon layer — the only place that knows which iconify icon backs a name.
 *
 * Call it as `partial('icon', { name: 'home', size: 20, extraClass: 'chev' })`.
 *
 * The drawings come straight from the iconify packs this theme depends on
 * (package.json — the same packs the original Firefly theme uses, so no icon
 * data is vendored here). Ngwg installs those packages into the theme
 * directory and the EJS deployer exposes a theme-scoped `require`, which is
 * what resolves the specifiers below.
 *
 * `name` is a public knob (theme.yaml writes icons for navbar/profile links),
 * so keep existing names when you change an icon. To add one, point it at a
 * `collection:icon` reference from the installed packs and run
 * `bun install` in the theme directory if you added a new pack.
 */
const ICON_MANIFEST = {
  // ---- navigation & chrome ----
  home: "material-symbols:home",
  archive: "material-symbols:archive",
  user: "material-symbols:person",
  menu: "material-symbols:menu-rounded",
  close: "material-symbols:close-rounded",
  search: "material-symbols:search",
  link: "material-symbols:link",
  external: "material-symbols:open-in-new",
  "arrow-up": "material-symbols:keyboard-arrow-up-rounded",
  more: "material-symbols:more-horiz",
  "chevron-left": "material-symbols:chevron-left-rounded",
  "chevron-right": "material-symbols:chevron-right-rounded",
  "chevron-down": "material-symbols:keyboard-arrow-down-rounded",
  // ---- theme switch ----
  sun: "material-symbols:light-mode-outline-rounded",
  moon: "material-symbols:dark-mode-outline-rounded",
  monitor: "material-symbols:brightness-auto-outline-rounded",
  palette: "material-symbols:palette-outline",
  reset: "fa7-solid:arrow-rotate-left",
  // ---- post metadata & widgets ----
  calendar: "material-symbols:calendar-today-outline-rounded",
  clock: "material-symbols:schedule-outline-rounded",
  "file-text": "material-symbols:notes-rounded",
  chart: "material-symbols:bar-chart",
  type: "material-symbols:text-ad-outline-rounded",
  folder: "material-symbols:folder-open-rounded",
  tag: "material-symbols:tag-rounded",
  announcement: "material-symbols:campaign-outline",
  music: "material-symbols:music-note",
  "address-card": "fa7-regular:address-card",
  copyright: "fa7-regular:copyright",
  cc: "fa7-brands:creative-commons",
  github: "fa7-brands:github",
  rss: "fa7-solid:rss",
};

// resolve the reference into drawing data: iconify icon sets carry a pack-wide
// grid (material-symbols: 24, font awesome: 640) that an icon may override,
// and aliases that point at another icon in the same set
function lookupIcon(set, id, seen) {
  const icon = set.icons[id];
  if (icon) return icon;
  const alias = set.aliases && set.aliases[id];
  if (alias && alias.parent && seen.indexOf(id) < 0) return lookupIcon(set, alias.parent, seen.concat(id));
  return null;
}

let drawing = null;
if (Object.prototype.hasOwnProperty.call(ICON_MANIFEST, name)) {
  const ref = String(ICON_MANIFEST[name]);
  const sep = ref.indexOf(":");
  const pack = "@iconify-json/" + ref.slice(0, sep);
  let set;
  try {
    set = require(pack).icons;
  } catch (e) {
    throw new Error(
      `icon "${name}" needs the theme dependency ${pack}, which is not installed — ` +
        `run "bun install" in the theme directory (Ngwg installs theme dependencies automatically). ${e.message}`,
    );
  }
  const icon = lookupIcon(set, ref.slice(sep + 1), []);
  if (icon) {
    drawing = {
      w: icon.width || set.width || 24,
      h: icon.height || set.height || 24,
      x: icon.left || 0,
      y: icon.top || 0,
      body: icon.body,
    };
  }
}
const px = (typeof size !== "undefined" && size) ? size : 20;
const klass = (typeof extraClass !== "undefined" && extraClass) ? " " + extraClass : "";
%>
<% if (drawing) { %><svg class="icon<%= klass %>" width="<%= px %>" height="<%= px %>" viewBox="<%= drawing.x %> <%= drawing.y %> <%= drawing.w %> <%= drawing.h %>" fill="currentColor" aria-hidden="true" focusable="false"><%- drawing.body %></svg><% } %>
