<%
/**
 * Tag cloud widget. Like upstream's Tags widget the list is clipped to
 * `sidebar.collapse.tags` entries (7.5rem tall) and a "more" toggle expands it;
 * 0 disables the collapse. Upstream links to a /tags/ index, which Ngwg does
 * not generate, so the button toggles instead.
 */
const tagList = h.tagCloud(site.tags || {});
const title = t.sidebar.tags;
const max = tagList.reduce((m, x) => Math.max(m, x.count), 1);
const threshold = Number((theme.sidebar && theme.sidebar.collapse && theme.sidebar.collapse.tags) || 0);
const collapsible = threshold > 0 && tagList.length > threshold;
const more = (t.widget && t.widget.more) || "more";
const less = (t.widget && t.widget.collapse) || "collapse";
%>
<% if (tagList.length) { %>
<section class="widget-card collapsible-card">
  <details open>
    <summary class="widget-title"><%- partial('icon', { name: 'tag' }) %><span><%= title %></span><%- partial('icon', { name: 'chevron-down', size: 16, extraClass: 'chev' }) %></summary>
    <div class="widget-collapse<%= collapsible ? ' collapsed' : '' %>">
      <div class="tag-cloud">
        <% for (const tag of tagList) { %>
        <a class="tag-item" href="/tags/<%= h.slugify(tag.name) %>/" style="--tag-weight: <%= (0.4 + 0.6 * (tag.count / max)).toFixed(2) %>">#<%= tag.name %><span class="tag-count"><%= tag.count %></span></a>
        <% } %>
      </div>
    </div>
    <% if (collapsible) { %>
    <button type="button" class="widget-expand" data-more="<%= more %>" data-less="<%= less %>" data-expanded="false" aria-expanded="false" aria-label="<%= more %>" title="<%= more %>">
      <span class="widget-expand-more"><%- partial('icon', { name: 'more', size: 24 }) %></span>
      <span class="widget-expand-less" hidden><%- partial('icon', { name: 'arrow-up', size: 24 }) %></span>
      <span class="widget-expand-text"><%= more %></span>
    </button>
    <% } %>
  </details>
</section>
<% } %>
