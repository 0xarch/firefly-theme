<%
/**
 * Table of contents widget. The list is filled in by the client from the
 * rendered <h2>/<h3>/<h4> in #post-body (so lazily loaded segments extend it
 * as they arrive).
 *
 * The widget is emitted only on post pages that actually contain headings —
 * `page.body` is the full raw markdown (segmentation only shortens `page.html`),
 * so the check covers headings that live in later segments. Without this the
 * right column would be reserved but empty.
 */
const title = t.sidebar.toc;
const body = String((page && page.body) || "");
const hasHeadings = view === "post" && /(^|\n)#{2,4}[ \t]+\S/.test(body);
%>
<% if (hasHeadings) { %>
<nav class="widget-card toc-card" id="toc" aria-label="<%= title %>">
  <div class="toc-head widget-title"><%- partial('icon', { name: 'file-text' }) %><span><%= title %></span>
    <button type="button" class="btn-icon toc-toggle" aria-expanded="true" aria-label="<%= title %>"><%- partial('icon', { name: 'chevron-down', size: 16, extraClass: 'chev' }) %></button>
  </div>
  <div class="toc-body">
    <div class="toc-list" role="list" aria-live="polite"></div>
    <p class="toc-empty" hidden><%= t.listing.empty %></p>
  </div>
</nav>
<% } %>
