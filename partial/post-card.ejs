<%
/**
 * One post card. Called from listing layouts via
 *   partial('post-card', { post })
 * so `post` is merged onto the root context.
 */
const pl = theme.postList || {};
const meta = post.meta || {};
const tags = Array.isArray(meta.tags) ? meta.tags : [];
const cats = Array.isArray(meta.categories) ? meta.categories : [];
const cover = typeof meta.cover === "string" ? meta.cover
  : typeof meta.image === "string" ? meta.image
  : typeof meta.banner === "string" ? meta.banner : "";
const coverSide = pl.coverPosition === "left" ? "cover-left" : "cover-right";

const plain = String(post.html || "").replace(/<[^>]+>/g, " ").replace(/&[a-z#0-9]+;/gi, " ");
const cjk = (plain.match(/[\u3400-\u9fff]/g) || []).length;
const latin = (plain.replace(/[\u3400-\u9fff]/g, " ").match(/[A-Za-z0-9]+/g) || []).length;
const words = cjk + latin;
const minutes = Math.max(1, Math.round(cjk / 400 + latin / 220));

const showTags = pl.showTags !== false;
const tagCount = Number.isFinite(Number(pl.tagCount)) ? Number(pl.tagCount) : 3;
const shownTags = tagCount > 0 ? tags.slice(0, tagCount) : tags;
const hiddenTagCount = tags.length - shownTags.length;
const stats = pl.stats || {};
const descLines = Number.isFinite(Number(pl.descriptionLines)) ? Number(pl.descriptionLines) : 2;
const desc = post.excerptHtml ? null : h.excerpt(post, 200);
// upstream wraps every meta icon in a tinted 2rem square (`.meta-icon`)
const metaIcon = (name) => `<span class="meta-icon">${partial('icon', { name, size: 20 })}</span>`;
%>
<article class="post-card<%= cover ? ' has-cover ' + coverSide : ' no-cover' %>">
  <div class="post-card-content">
    <a class="post-card-title" href="<%= post.url %>"><%= meta.title %></a>
    <div class="post-card-meta">
      <% if (stats.published !== false && meta.date) { %>
      <span class="meta-item"><%- metaIcon('calendar') %><time datetime="<%= meta.date %>"><%= h.formatDate(meta.date, "YYYY-MM-DD") %></time></span>
      <% } %>
      <% if (stats.words !== false) { %><span class="meta-item"><%- metaIcon('file-text') %><%= h.t("post.words_count", words) %></span><% } %>
      <% if (stats.reading !== false) { %><span class="meta-item"><%- metaIcon('clock') %><%= h.t("post.reading_time", minutes) %></span><% } %>
      <% if (cats.length) { %>
      <span class="meta-item"><%- metaIcon('folder') %><% for (const c of cats) { %><a class="meta-link" href="/categories/<%= h.slugify(c) %>/"><%= c %></a><% } %></span>
      <% } %>
    </div>
    <% if (post.excerptHtml) { %>
    <div class="post-card-desc"<%- descLines > 0 ? ` style="-webkit-line-clamp:${descLines};line-clamp:${descLines}"` : '' %>><%- post.excerptHtml %></div>
    <% } else if (desc) { %>
    <div class="post-card-desc"<%- descLines > 0 ? ` style="-webkit-line-clamp:${descLines};line-clamp:${descLines}"` : '' %>><%= desc %></div>
    <% } %>
    <% if (showTags && shownTags.length) { %>
    <div class="post-card-tags">
      <% for (const tag of shownTags) { %><a class="tag-item" href="/tags/<%= h.slugify(tag) %>/">#<%= tag %></a><% } %>
      <% if (hiddenTagCount > 0) { %><span class="tag-item tag-item-static" title="<%= tags.slice(shownTags.length).map((t) => '#' + t).join(' ') %>">+<%= hiddenTagCount %></span><% } %>
    </div>
    <% } %>
  </div>
  <% if (cover) { %>
  <a class="post-card-cover" href="<%= post.url %>" aria-label="<%= meta.title %>" tabindex="-1">
    <img src="<%= cover %>" alt="" loading="lazy">
    <span class="post-card-cover-arrow"><%- partial('icon', { name: 'chevron-right', size: 34 }) %></span>
  </a>
  <% } else { %>
  <a class="post-card-enter" href="<%= post.url %>" aria-label="<%= meta.title %>" tabindex="-1"><%- partial('icon', { name: 'chevron-right', size: 36 }) %></a>
  <% } %>
</article>
