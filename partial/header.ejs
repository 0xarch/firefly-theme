<%
/**
 * <head> + <body> opening + navbar + banner + content-panel/grid opening.
 *
 * `view` (home|post|page|archive|tag|category) and `navUrl` are passed in by
 * each layout; because partial() merges extra data onto the root context,
 * nested partials (navbar, banner, sidebar) see them too.
 */
const tc = theme.themeColor || {};
const hue = Number.isFinite(Number(tc.hue)) ? Number(tc.hue) : 165;
const defaultMode = tc.defaultMode || "system";
const navbar = theme.navbar || {};
const bannerCfg = theme.banner || {};
const sidebarCfg = theme.sidebar || {};
const profile = theme.profile || {};

const pageTitle = page && page.meta && page.meta.title
  ? `${page.meta.title} · ${site.title}`
  : site.title;
const pageDesc = (page && page.meta && (page.meta.description || page.meta.excerpt)) || site.description || "";

// per-post language: `lang` (Astro Firefly) or its `language` alias
// (Nextario) only changes the document language and hreflang links; the UI
// strings still follow the site language. `multi_language` maps language tags
// to the URLs of the translated versions.
const rawPageLang = page && page.meta && (page.meta.lang || page.meta.language);
const pageLang = rawPageLang
  ? String(rawPageLang).trim().split(/[.@]/)[0].replace(/_/g, "-")
  : langAttr;
const translations = page && page.meta && page.meta.multi_language;
const translationEntries = translations && typeof translations === "object" && !Array.isArray(translations)
  ? Object.entries(translations).filter(([, v]) => typeof v === "string" || (v && typeof v.url === "string"))
  : [];
const hasHomeText = bannerCfg.mode !== "none" && bannerCfg.homeText && bannerCfg.homeText.enable !== false;
const sidebarPosition = sidebarCfg.enable === false ? "none" : (sidebarCfg.position || "both");
// which side stays when both are configured but only one fits (768-1279px)
const tabletSidebar = sidebarCfg.tabletSidebar === "right" ? "right" : "left";

const siteStats = theme.siteStats || {};
// newest activity across posts — drives the live "last update" stat row.
// `site.posts` is a slice on paginated listings, so read every post from the
// archive groups instead (see partial/widget/stats.ejs). Only needed when the
// stats card is enabled.
let lastActivity = null;
if (siteStats.enable !== false) {
  const allPosts = Array.isArray(site.archives) && site.archives.length
    ? site.archives.reduce((acc, g) => acc.concat(g.posts || []), [])
    : (site.posts || []);
  for (const post of allPosts) {
    const raw = post.meta && (post.meta.updated || post.meta.date);
    if (!raw) continue;
    const d = new Date(raw);
    if (!isNaN(d.getTime()) && (!lastActivity || d > lastActivity)) lastActivity = d;
  }
}

// config carrier: JSON, "<" escaped so a "</script>" in config can never break out
const runtimeConfig = {
  hue,
  defaultMode,
  navbarMode: navbar.mode || "dynamic",
  bannerMode: bannerCfg.mode || "banner",
  bannerPosition: bannerCfg.position || "center",
  bannerDim: Number.isFinite(Number(bannerCfg.dimOpacity)) ? Number(bannerCfg.dimOpacity) : 0.2,
  bannerDesktop: bannerCfg.desktop || [],
  bannerMobile: bannerCfg.mobile || [],
  bannerPostInfoMode: (bannerCfg.postInfo && bannerCfg.postInfo.mode) || "description",
  bannerSubtitles: (bannerCfg.homeText && bannerCfg.homeText.subtitle) || [],
  typewriter: (bannerCfg.homeText && bannerCfg.homeText.typewriter) || { enable: false },
  isHome: view === "home",
  comments: theme.comments || { enable: false },
  searchLimit: (theme.search && Number(theme.search.limit)) || 12,
  searchHotkey: !(theme.search && theme.search.hotkey === false),
  pjax: true,
  siteStats: {
    startDate: siteStats.startDate || "",
    lastPostDate: lastActivity ? lastActivity.toISOString() : "",
    today: (t.siteStats && t.siteStats.today) || "",
  },
  i18n: {
    backToTop: t.post && t.post.back_to_top,
    toc: t.sidebar && t.sidebar.toc,
    copy: (t.post && t.post.copy) || "copy",
    copied: (t.post && t.post.copied) || "copied",
  },
};
const configJson = JSON.stringify(runtimeConfig).replace(/</g, "\\u003c");
%><!DOCTYPE html>
<html lang="<%= pageLang %>" data-wallpaper-mode="<%= bannerCfg.mode || 'banner' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="darkreader-lock">
  <meta name="theme-color" content="oklch(0.70 0.14 <%= hue %>)">
  <title><%= pageTitle %></title>
  <% if (page && page.meta && page.meta.noindex) { %><meta name="robots" content="noindex">
  <% } %>
  <% if (typeof h.seoMeta === "function") { %><%- h.seoMeta(page, site) %>
  <% } else { %><meta name="description" content="<%= pageDesc %>">
  <% } %>
  <% if (site.extra && site.extra.seo && site.extra.seo.generateRSS) { %>  <link rel="alternate" type="application/rss+xml" title="<%= site.title %>" href="<%= site.extra.seo.rssPath %>">
  <% } %>
  <% if (site.extra && site.extra.seo && site.extra.seo.generateAtom) { %>  <link rel="alternate" type="application/atom+xml" title="<%= site.title %>" href="<%= site.extra.seo.atomPath %>">
  <% } %>
  <% for (const [code, target] of translationEntries) { const href = typeof target === "string" ? target : target.url; const abs = typeof h.absoluteUrl === "function" ? h.absoluteUrl(href, site) : href; %>
  <link rel="alternate" hreflang="<%= String(code).replace(/_/g, '-') %>" href="<%= abs %>">
  <% } %>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon/firefly-32.png">
  <link rel="apple-touch-icon" href="/assets/images/favicon/firefly-180.png">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/navbar.css">
  <link rel="stylesheet" href="/assets/css/overlays.css">
  <link rel="stylesheet" href="/assets/css/banner.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/widgets.css">
  <link rel="stylesheet" href="/assets/css/posts.css">
  <link rel="stylesheet" href="/assets/css/article.css">
  <link rel="stylesheet" href="/assets/css/post-extras.css">
  <link rel="stylesheet" href="/assets/css/footer.css">
  <link rel="stylesheet" href="/assets/css/dynamic.css">
  <% if (site.extra && site.extra.markdown && site.extra.markdown.tex && site.extra.markdown.tex.katex) { %>
  <link rel="stylesheet" href="/assets/katex/katex.min.css">
  <% } %>
  <script>
    // set the colour scheme and hue before first paint (no flash)
    (function () {
      try {
        const mode = localStorage.getItem("theme") || "<%= defaultMode %>";
        const dark = mode === "dark" || (mode === "system" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        const h = localStorage.getItem("hue");
        if (h) document.documentElement.style.setProperty("--hue", h);
        const scheme = localStorage.getItem("code-scheme");
        document.documentElement.setAttribute("data-code-scheme", scheme === "github" ? "github" : "atom");
      } catch (e) {}
    })();
  </script>
  <script>window.__FIREFLY__ = <%- configJson %>;</script>
</head>
<body class="<%= view === 'home' ? 'is-home' : '' %>" data-view="<%= view %>" data-navbar-mode="<%= navbar.mode || 'dynamic' %>" data-sidebar-position="<%= sidebarPosition %>" data-tablet-sidebar="<%= tabletSidebar %>">
<a class="skip-link" href="#content-wrapper"><%= t.nav.home %></a>
<% if (view === "post") { %><div id="progress-bar" aria-hidden="true"></div>
<% } %><%- partial('navbar') %>
<%- partial('banner') %>
<div id="content-panel">
  <div id="content-panel-inner">
    <div id="main-grid">
      <%- partial('sidebar', { side: 'left' }) %>
      <div id="content-column">
        <main id="swup-container" class="transition-main" data-page-url="<%= navUrl || '/' %>">
          <% if (!(view === "post" && (bannerCfg.mode || "banner") !== "none")) { %>
          <h1 class="sr-only"><%= (page && page.meta && page.meta.title) || (typeof navTitle !== "undefined" ? navTitle : site.title) %></h1>
          <% } %>
          <div id="content-wrapper" class="onload-animation">
