<%- partial('header', { view: 'archive', navUrl: '/archives/', navTitle: t.archive.title, bannerTitle: t.archive.title }) %>
<div class="listing-head">
  <h2 class="listing-title"><%= t.archive.title %></h2>
  <p class="listing-subtitle"><%= h.t("archive.subtitle", site.posts.length) %></p>
</div>
<div class="archive">
  <% const groups = site.archives || []; %>
  <% if (!groups.length) { %><p class="empty-note"><%= t.listing.empty %></p><% } %>
  <% for (let gi = 0; gi < groups.length; gi++) { const group = groups[gi]; %>
  <details class="archive-group"<%= gi === 0 ? ' open' : '' %>>
    <summary class="archive-year">
      <span class="archive-year-name"><%= group.name %></span>
      <span class="archive-year-count"><%= group.posts.length %></span>
      <%- partial('icon', { name: 'chevron-down', size: 16, extraClass: 'chev' }) %>
    </summary>
    <ul class="archive-list">
      <% for (const post of group.posts) { %>
      <li class="archive-item">
        <time datetime="<%= post.meta.date %>"><%= h.formatDate(post.meta.date, "MM-DD") %></time>
        <a href="<%= post.url %>"><%= post.meta.title %></a>
      </li>
      <% } %>
    </ul>
  </details>
  <% } %>
</div>
<%- partial('footer', { view: 'archive', navUrl: '/archives/' }) %>
